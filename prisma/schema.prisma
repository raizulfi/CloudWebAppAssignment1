// Prisma schema for Escape Room backend
// Provider: PostgreSQL (set DATABASE_URL in .env.local)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  userTag      String        @unique
  gameProgress GameProgress?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model GameProgress {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStage  Int      @default(0)
  timeRemaining Int      @default(300)
  stage1Code    String?
  stage2Code    String?
  stage3Code    String?
  stage4Code    String?
  stage5Code    String?
  stage6Code    String?
  stage2BugFound Boolean  @default(false)
  gameStarted    Boolean  @default(false)
  gameWon        Boolean  @default(false)
  gameLost       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lastSaved      DateTime @default(now())

  @@unique([userId])
  @@index([userId])
}
